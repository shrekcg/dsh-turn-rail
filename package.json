{
  "name": "dsh-turn-rail",
  "version": "0.1.2",
  "description": "给 DSH Web UI 长对话的轮次刻度滑轨：每条提问一根刻度，悬停预览、点击跳转，带当前位置与滚动进度。纯客户端，不依赖 host RPC。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "navigation",
    "timeline"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrekcg/dsh-turn-rail.git"
  },
  "bugs": {
    "url": "https://github.com/shrekcg/dsh-turn-rail/issues"
  },
  "homepage": "https://github.com/shrekcg/dsh-turn-rail#readme",
  "license": "MIT"
}
